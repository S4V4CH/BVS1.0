generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmissionStatus {
  PENDING
  CONFIRMED
  FAILED
}

model TicketEmission {
  voteId       String         @id @db.Uuid // Identifier provided by main backend
  electionId   String         @db.VarChar(255)
  voterToken   String         @db.VarChar(255) // Reference ID
  status       EmissionStatus @default(PENDING)
  txHash       String?        @unique @db.VarChar(100)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  errorMessage String?        @db.Text

  @@map("ticket_emissions")
}
