# Copia este archivo a `.env` y rellena los valores (no subas `.env` a git).

PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://bvsuser:bvspassword@localhost:5433/ticket_issuer_db?schema=public
STELLAR_NETWORK=TESTNET

# Clave secreta de la cuenta emisora en Stellar (testnet). Debe ser una cadena larga válida.
STELLAR_ISSUER_SECRET=

# URL del webhook de notificación (puede ser un endpoint de prueba).
WEBHOOK_URL=http://localhost:8080/webhook-test
