{
  "name": "bvs-ticket-issuer",
  "version": "1.0.0",
  "description": "Microservicio emisor de tickets para testnet Stellar (BVS)",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/env": "^5.0.0",
    "@prisma/client": "^5.10.0",
    "@stellar/stellar-sdk": "^11.2.2",
    "dotenv": "^17.4.2",
    "fastify": "^4.26.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "@types/pino": "^7.0.5",
    "eslint": "^8.57.0",
    "prisma": "^5.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.5"
  }
}
