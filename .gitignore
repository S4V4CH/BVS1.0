# --- Dependencias (nunca versionar) ---
node_modules/

# --- Salidas de build / compilación ---
dist/
build/
out/
*.tsbuildinfo

# --- Cachés de herramientas ---
.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache
*.tsbuildinfo

# --- Entornos y secretos (mantener .env.example si existe) ---
.env
.env.*
!.env.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

